# =====================================================================
# VidSnap AI — Production Backend Dockerfile
# FastAPI + FFmpeg + Voice Synthesis + Persistent Volume Mounts
# =====================================================================

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/backend \
    DATA_DIR=/app/data \
    MEDIA_DIR=/app/media

# Install native dependencies: FFmpeg, FFprobe, and TrueType fonts for ASS subtitles
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-dejavu-core \
    fonts-liberation \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY backend/requirements.txt /app/backend/
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

# Copy backend source code
COPY backend /app/backend/

# Copy default templates and background audio for volume seeding
COPY media/templates /app/default_media/templates/
COPY media/songs /app/default_media/songs/

# Create persistent storage mount directories
RUN mkdir -p /app/data /app/media

# Expose backend port
EXPOSE 8000

# Container healthcheck using VidSnap's /api/health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Start FastAPI with uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
