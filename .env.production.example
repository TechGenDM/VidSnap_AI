# =====================================================================
# VidSnap AI — Production Environment Configuration
# =====================================================================
# IMPORTANT:
# 1. Never commit this file with real credentials to version control.
# 2. In production, inject these variables via your cloud host's secure
#    environment variable manager (e.g. Railway, Render, Fly.io, or VPS).
# 3. VidSnap requires persistent disk storage mounted at /app/data
#    (persists both vidsnap_store.json and /app/data/media/ in one volume).
# =====================================================================

# ---------------------------------------------------------------------
# Application & Environment Settings
# ---------------------------------------------------------------------
APP_NAME="VidSnap AI"
VERSION="2.0.0"
DEBUG=false

# ---------------------------------------------------------------------
# Storage Paths (Point to your persistent volume mount)
# In Railway/Docker with single volume mount at /app/data:
# ---------------------------------------------------------------------
DATA_DIR="/app/data"
MEDIA_DIR="/app/data/media"

# ---------------------------------------------------------------------
# Networking & CORS
# In production, set this to your exact frontend domain(s)
# Can be a JSON array or comma-separated string
# ---------------------------------------------------------------------
CORS_ORIGINS=["https://vidsnap.app","https://www.vidsnap.app"]

# ---------------------------------------------------------------------
# Frontend Configuration (Used by Next.js)
# ---------------------------------------------------------------------
# Port Next.js will bind to
PORT=3000

# Client-side API URL (optional if using Next.js server rewrites)
NEXT_PUBLIC_API_URL=https://api.vidsnap.app

# Internal backend URL used by Next.js rewrites to reach FastAPI
# In Docker Compose, this is http://backend:8000
BACKEND_INTERNAL_URL=http://backend:8000

# ---------------------------------------------------------------------
# AI & Voice Generation Services
# ---------------------------------------------------------------------
# ElevenLabs API Key (Required for studio voice narration and word-level ASS subtitles)
# Key must start with 'sk_'
ELEVENLABS_API_KEY=sk_your_elevenlabs_production_api_key_here
ELEVENLABS_DEFAULT_VOICE="Adam"

# OpenAI API Key (Optional — if unset or empty, VidSnap uses its built-in
# deterministic creative story engine with zero API cost and instant response)
OPENAI_API_KEY=

# Pollinations API Key (Optional — if unset, VidSnap seamlessly falls back
# to curated high-resolution local visual templates)
POLLINATIONS_API_KEY=

# ---------------------------------------------------------------------
# Video Rendering & Upload Constraints
# ---------------------------------------------------------------------
FFMPEG_TIMEOUT_SECONDS=120
MAX_UPLOAD_SIZE_MB=15
