# =====================================================================
# VidSnap AI — Production Frontend Dockerfile
# Next.js 16 (App Router) Standalone / Production Build
# =====================================================================

FROM node:20-alpine AS builder

WORKDIR /app/frontend

ARG BACKEND_INTERNAL_URL=http://backend:8000
ENV BACKEND_INTERNAL_URL=${BACKEND_INTERNAL_URL}

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

# Build Next.js production bundle
ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

RUN npm run build

# Runner stage
FROM node:20-alpine AS runner

WORKDIR /app/frontend

ENV NODE_ENV=production \
    PORT=3000 \
    NEXT_TELEMETRY_DISABLED=1 \
    BACKEND_INTERNAL_URL=http://backend:8000

COPY --from=builder /app/frontend/package*.json ./
COPY --from=builder /app/frontend/node_modules ./node_modules
COPY --from=builder /app/frontend/.next ./.next
COPY --from=builder /app/frontend/public ./public
COPY --from=builder /app/frontend/next.config.ts ./

EXPOSE 3000

# Start Next.js (respecting Railway's dynamic $PORT with 3000 default)
CMD ["sh", "-c", "exec npx next start -H 0.0.0.0 -p ${PORT:-3000}"]
